# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=../data/database.sqlite

# AI Services (choose one or both)
# 豆包 API
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=your_model_name

# 通义千问 API
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# Whisper API (OpenAI compatible)
WHISPER_API_URL=http://localhost:8080/inference
# Or use OpenAI API:
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=your_openai_api_key

# JWT Secret
JWT_SECRET=your_jwt_secret_change_this_in_production

# 认证初始化（首次部署时自动创建管理员与初始邀请码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FamilyVault@2026
INITIAL_INVITATION_CODE=FAMILY2026

# 认证初始化（首次部署时创建管理员与初始邀请码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FamilyVault@2026
INITIAL_INVITATION_CODE=FAMILY2026

# File Upload
UPLOAD_DIR=../data/uploads
MAX_FILE_SIZE=104857600

# Time Capsule
CAPSULE_CHECK_INTERVAL=0 0 * * *